# 复制成 .env 后按需修改（不要提交 .env 到仓库）

# Agent 网关地址（OpenAI 兼容 /v1/chat/completions）
NEXAGI_GATEWAY=http://127.0.0.1:8642

# 网关 API Key；没有就留空
NEXAGI_API_KEY=

# 中转监听端口（插件 config.yml 里的 bridge-url 要对应）
NEXAGI_BRIDGE_PORT=8899

# 数据目录：放 mc_ports.json 和日志，默认 ~/.nexagi
NEXAGI_HOME=

# 可选：实例名 -> 会话 slug 的映射（JSON），不填则自动取 ASCII 或哈希
# NEXAGI_SLUGS={"生存服": "survive", "小游戏": "minigame"}
